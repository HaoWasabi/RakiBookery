# ============================================================
# RakiBookery - Environment Variables Template
# Copy file này thành .env và điền giá trị thật
# ============================================================

# --- App ---
# true  → hiển thị lỗi PHP trên trình duyệt (chỉ dùng khi dev)
# false → tắt display_errors, chỉ ghi vào error_log (dùng cho production / Docker)
APP_DEBUG=false
# true  → bật cookie secure (khi chạy sau HTTPS: load balancer, CloudFront)
APP_HTTPS=false


# --- Nguồn dữ liệu sách ---
# "mock"  → dùng dữ liệu giả lập (không cần DB / S3)
# "live"  → dùng dữ liệu thật từ DB và ảnh từ S3
BOOK_DATA_SOURCE=mock

# --- Database ---
DB_HOST=localhost
DB_NAME=bookstoredb
DB_USERNAME=root
DB_PASSWORD=

# --- PayPal ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_VND_TO_USD_RATE=25000

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=
AWS_S3_FOLDER=media

# --- Notify API (API Gateway → Lambda → SNS) ---
# Lấy từ Output "HttpApiEndpoint" của stack raki-cdn-monitoring
# Ví dụ: https://abc123.execute-api.ap-southeast-1.amazonaws.com/notify
NOTIFY_API_URL=

# --- AI Chatbot API (API Gateway → Lambda → Bedrock) ---
# Lấy từ Output endpoint của stack AI chatbot
# Ví dụ: https://abc123.execute-api.ap-southeast-1.amazonaws.com/dev/chat
AI_API_URL=

# --- CDN API (Cloudfront) ---
# Lấy từ Output endpoint của stack raki-cdn-monitoring
CDN_URL=
