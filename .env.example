# ============================================================
# RakiBookery - Environment Variables Template
# Copy file này thành .env và điền giá trị thật
# ============================================================

# --- Nguồn dữ liệu sách ---
# "mock"  → dùng dữ liệu giả lập (không cần DB / S3)
# "live"  → dùng dữ liệu thật từ DB và ảnh từ S3
BOOK_DATA_SOURCE=mock

# --- Database ---
DB_HOST=localhost
DB_NAME=bookstoredb
DB_USER=root
DB_PASS=

# --- PayPal ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_VND_TO_USD_RATE=25000

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
AWS_BUCKET=
AWS_S3_FOLDER=media
